{
  "name": "nail-planner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "version-assets": "node scripts/version-assets.js",
    "deploy": "npm run version-assets && wrangler deploy",
    "migrate": "node scripts/migrate.js",
    "typecheck": "tsc --noEmit && node scripts/check-frontend.js",
    "test": "node scripts/test.js",
    "test:browser": "playwright test",
    "test:load": "node scripts/test.js test/load.test.ts --silent=false"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@playwright/test": "1.62.1",
    "jsdom": "^30.1.2",
    "typescript": "^5.6.0",
    "vitest": "5.0.5",
    "wrangler": "4.151.2"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
